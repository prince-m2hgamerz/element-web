.mx_VerifiedBadge {
    --mx-verified-size: 14px;

    width: var(--mx-verified-size);
    height: var(--mx-verified-size);
    border-radius: 999px;
    background-color: #1d9bf0;
    color: #fff;
    margin-inline-start: 4px;
    font-size: 9px;
    font-weight: 800;
    line-height: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    vertical-align: middle;
    flex-shrink: 0;
    border: 1px solid rgb(255 255 255 / 80%);
}
